const isFill = name in fill;
const body = isFill ? fill[name] : stroke[name] ?? stroke.arrow;
---

{isFill ? (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined} focusable="false">
    {title && <title>{title}</title>}
    <Fragment set:html={body} />
  </svg>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined} focusable="false">
    {title && <title>{title}</title>}
    <Fragment set:html={body} />
  </svg>
)}
