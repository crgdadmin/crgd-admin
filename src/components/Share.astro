---
import Icon from './Icon.astro';

interface Props {
  title: string;
  label?: string;
  heading?: boolean;
}
const { title, label = 'Share', heading = true } = Astro.props;
const link = new URL(Astro.url.pathname, Astro.site).toString();
const t = encodeURIComponent(title);
const u = encodeURIComponent(link);
const targets = [
  { name: 'x', label: 'Share on X', href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { name: 'linkedin', label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'facebook', label: 'Share on Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'whatsapp', label: 'Share on WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { name: 'mail', label: 'Share by email', href: `mailto:?subject=${t}&body=${u}` },
];
---

<div class="share-block">
  {heading && <h2 class="sr-only">{label}</h2>}
  <ul class="share" aria-label={label}>
    {targets.map((s) => (
      <li>
        <a href={s.href} target={s.name === 'mail' ? undefined : '_blank'} rel="noopener noreferrer" aria-label={s.label} title={s.label}>
          <Icon name={s.name} />
        </a>
      </li>
    ))}
    <li>
      <button type="button" class="share-copy" data-url={link} aria-label="Copy link" title="Copy link"><Icon name="link" /></button>
    </li>
    <li>
      <button type="button" class="share-print" aria-label="Print this page" title="Print"><Icon name="print" /></button>
    </li>
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.url ?? window.location.href);
        button.classList.add('copied');
        window.setTimeout(() => button.classList.remove('copied'), 1800);
      } catch {
        window.prompt('Copy this link', button.dataset.url ?? window.location.href);
      }
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.share-print').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>
