---
import { url } from '../lib/site';

interface Props {
  heading?: string;
  links: { label: string; href: string }[];
}
const { heading = 'In this section', links } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
const isHere = (href: string) => url(href).replace(/\/$/, '') === here;
---

{links.length > 0 && (
  <nav class="aside-box aside-nav" aria-label={heading}>
    <h2>{heading}</h2>
    <ul>
      {links.map((l) => (
        <li><a href={url(l.href)} aria-current={isHere(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
)}
