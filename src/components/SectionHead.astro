---
import { url } from '../lib/site';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  link?: string;
  linkLabel?: string;
  as?: 'h2' | 'h3';
}
const { eyebrow, title, text, link, linkLabel = 'View all', as: Tag = 'h2' } = Astro.props;
---

<div class="section-head">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag>{title}</Tag>
    {text && <p>{text}</p>}
  </div>
  {link && <a class="text-link" href={url(link)}>{linkLabel}</a>}
</div>
