---
import { site, orgName } from '../lib/site';

interface Props {
  subject?: string;
  heading?: string;
  topics?: string[];
}
const {
  subject = `Enquiry through the ${orgName} website`,
  heading = 'Send us a message',
  topics = [
    'General enquiry',
    'Research collaboration',
    'Media and interviews',
    'Fellowships and internships',
    'CRGD Academy and courses',
    'Events and speaking invitations',
    'Support and partnerships',
    'Correction or feedback on a publication',
  ],
} = Astro.props;
const hasForm = Boolean(site.web3formsKey);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<div class="contact-form">
  <h2>{heading}</h2>
  {hasForm ? (
    <form class="form-grid two" id="contact-form">
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value={subject} />
      <input type="hidden" name="from_name" value={`${orgName} website`} />
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
      <div>
        <label for="cf-name">Your name</label>
        <input type="text" id="cf-name" name="name" autocomplete="name" required />
      </div>
      <div>
        <label for="cf-email">Email address</label>
        <input type="email" id="cf-email" name="email" autocomplete="email" required />
      </div>
      <div>
        <label for="cf-phone">Phone (optional)</label>
        <input type="tel" id="cf-phone" name="phone" autocomplete="tel" />
      </div>
      <div>
        <label for="cf-org">Organisation or institution</label>
        <input type="text" id="cf-org" name="organisation" autocomplete="organization" />
      </div>
      <div class="full">
        <label for="cf-topic">What is this about?</label>
        <select id="cf-topic" name="topic">
          {topics.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div class="full">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" required></textarea>
      </div>
      <div class="full">
        <label class="consent"><input type="checkbox" name="consent" required /> I agree that {orgName} may use these details to reply to me, as described in the privacy policy.</label>
      </div>
      <div class="full">
        <button class="btn" type="submit">Send message</button>
        <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  ) : (
    <div class="form-grid">
      <p>
        Write to <a href={mailto}>{site.email}</a> with your name, your organisation and a few lines about your
        enquiry. We reply to every message within five working days.
      </p>
      <p><a class="btn" href={mailto}>Compose an email</a></p>
    </div>
  )}
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (status) { status.className = 'form-status'; status.textContent = 'Sending your message…'; }
    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json();
      if (!result.success) throw new Error(result.message);
      form.reset();
      if (status) { status.className = 'form-status ok'; status.textContent = 'Thank you. Your message has been sent and we will reply within five working days.'; }
    } catch {
      if (status) { status.className = 'form-status error'; status.textContent = 'The message did not go through. Please email us directly.'; }
    }
  });
</script>
