---
import Picture from './Picture.astro';
import { href, isUpcoming, type EventEntry } from '../lib/content';
import { url, dateParts, dateRange, timeRange } from '../lib/site';

interface Props {
  event: EventEntry;
  image?: boolean;
}
const { event, image = false } = Astro.props;
const d = event.data;
const parts = dateParts(d.startDate);
const upcoming = isUpcoming(event);
---

<article class="card event-card" data-year={parts.year} data-type={d.type} data-text={`${d.title} ${d.summary ?? ''} ${d.speakers.join(' ')} ${d.venue ?? ''}`.toLowerCase()}>
  {image && <Picture src={d.image} alt={d.imageAlt} label={d.type} seed={event.id} placeholder={d.placeholder} />}
  <div class="card-body">
    <div class:list={['date-block', { 'is-past': !upcoming }]} aria-hidden="true">
      <span class="d">{parts.day}</span>
      <span class="m">{parts.month}</span>
      <span class="y">{parts.year}</span>
    </div>
    <div class="event-text">
      <p class="label card-type"><span class="nw">{d.type}</span><span class="dot nw">{d.mode}</span></p>
      <h3><a href={url(href.event(event))}>{d.title}</a></h3>
      <p class="meta">
        <time datetime={d.startDate.toISOString()}>{dateRange(d.startDate, d.endDate)}</time>
        {d.startTime && <span class="dot">{timeRange(d.startTime, d.endTime)}</span>}
      </p>
      {(d.venue || d.city) && <p class="meta">{[d.venue, d.city].filter(Boolean).join(', ')}</p>}
      {!image && d.placeholder && <p class="meta"><span class="tag">Placeholder</span></p>}
    </div>
  </div>
</article>
