---
import ListingPage from '../../components/ListingPage.astro';
import EventCard from '../../components/EventCard.astro';
import { splitEvents } from '../../lib/content';
import { sections } from '../../lib/site';

const { upcoming: items } = await splitEvents();
const years = [...new Set(items.map((e) => e.data.startDate.getFullYear()))];
---

<ListingPage
  title="Upcoming events"
  description="Lectures, roundtables, workshops and conferences that are open for registration. Most are free and open to the public."
  eyebrow={sections.events.title}
  crumbs={[{ label: 'Events', href: '/events' }, { label: 'Upcoming events' }]}
  siblings={[{ label: 'Upcoming', href: '/events/upcoming' }, { label: 'Past events', href: '/events/past' }]}
  allHref="/events"
  allLabel="All events"
>
  {items.length > 0 ? (
    years.length > 1 && 'upcoming' === 'past' ? (
      years.map((y) => (
        <div class="group-block">
          <div class="group-head"><h2>{y}</h2></div>
          <div class="grid grid-3">{items.filter((e) => e.data.startDate.getFullYear() === y).map((e) => <EventCard event={e} />)}</div>
        </div>
      ))
    ) : (
      <div class="grid grid-3">{items.map((e) => <EventCard event={e} image />)}</div>
    )
  ) : (
    <div class="empty"><p>No events are scheduled right now. Subscribe to email updates to hear about the next one.</p></div>
  )}
</ListingPage>
