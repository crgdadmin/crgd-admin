---
import DetailPage from '../../components/DetailPage.astro';
import { render } from 'astro:content';
import { getUpdates, href, type Update } from '../../lib/content';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getUpdates()).map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props as { item: Update };
const d = item.data;
const { Content } = await render(item);
const updates = await getUpdates();
---

<DetailPage
  title={d.title}
  description={d.summary}
  eyebrow={`Update · ${formatDate(d.date)}`}
  crumbs={[{ label: 'Latest updates', href: '/updates' }, { label: d.title }]}
  image={d.image}
  imageAlt={d.imageAlt}
  imageCaption={d.imageCaption}
  placeholder={d.placeholder}
  what="update"
  type="article"
  published={d.date}
  facts={[{ label: 'Published', value: formatDate(d.date) }]}
  actions={[{ label: d.linkLabel || 'Find out more', href: d.link, primary: true, icon: 'arrow' }]}
  navHeading="Recent updates"
  navLinks={updates.filter((u) => u.id !== item.id).slice(0, 8).map((u) => ({ label: u.data.title, href: href.update(u) }))}
>
  <Content />
</DetailPage>
