---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { applications, applicationForms, embeddedFormUrl, site, url, type ApplicationForm } from '../../lib/site';

export function getStaticPaths() {
  return applicationForms.map((form) => ({ params: { form: form.slug }, props: { form } }));
}
const { form } = Astro.props as { form: ApplicationForm };
const formUrl = form.formUrl?.trim();
const mailto = site.careersEmail ? `mailto:${site.careersEmail}?subject=${encodeURIComponent(`Application: ${form.title}`)}` : undefined;
---

<Base title={`${form.title}: application`} description={form.description}>
  <PageHead
    eyebrow="Application form"
    title={form.title}
    lede={form.description}
    crumbs={[{ label: 'Careers', href: '/careers' }, { label: applications.title || 'Apply', href: '/apply' }, { label: form.title }]}
  />

  <section class="band">
    <div class="wrap-narrow">
      {formUrl ? (
        <>
          <p class="notice">
            If the form does not appear below, <a href={formUrl} target="_blank" rel="noopener noreferrer">open it in a new tab</a>.
            {site.careersEmail && <>{' '}For questions, write to <a href={`mailto:${site.careersEmail}`}>{site.careersEmail}</a>.</>}
          </p>
          <iframe class="application-form" title={`${form.title} application form`} src={embeddedFormUrl(formUrl)} loading="lazy"></iframe>
        </>
      ) : (
        <div class="notice">
          <p>The online form for this opens soon.</p>
          {mailto && <p>Until then, please apply by email to <a href={mailto}>{site.careersEmail}</a> with your CV, a short note on why you are applying and, for research roles, one writing sample.</p>}
        </div>
      )}
      <p class="meta">Read how we use your information in our <a href={url('/privacy-policy')}>privacy policy</a>.</p>
    </div>
  </section>
</Base>
