---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="band not-found">
    <div class="wrap-narrow">
      <p class="eyebrow">Error 404</p>
      <h1>This page could not be found</h1>
      <p class="lede">It may have moved, or the address may be mistyped. Try searching the website, or start again from one of these pages.</p>
      <form class="subscribe-form light" action={url('/search')} method="get" role="search" style="margin:2rem 0">
        <label class="sr-only" for="nf-q">Search the website</label>
        <input type="search" id="nf-q" name="q" placeholder="Search the website" />
        <button class="btn" type="submit">Search</button>
      </form>
      <ul class="pills">
        <li><a href={url('/')}>Home</a></li>
        <li><a href={url('/research')}>Research</a></li>
        <li><a href={url('/publications')}>Publications</a></li>
        <li><a href={url('/events')}>Events</a></li>
        <li><a href={url('/people')}>People</a></li>
        <li><a href={url('/contact')}>Contact</a></li>
      </ul>
    </div>
  </section>
</Base>
