---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';
import { site, url, absolute, fonts, orgName, orgFullName, orgTitle, socialLinks } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  authors?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = site.footerNote ?? '',
  image,
  imageAlt,
  type = 'website',
  published,
  modified,
  authors = [],
  schema,
  noindex = false,
} = Astro.props;

const isHome = (Astro.url.pathname.replace(/\/$/, '') || '/') === (url('/').replace(/\/$/, '') || '/');
const pageTitle = isHome ? `${orgTitle} | ${orgFullName}` : `${title} | ${orgTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const shareImage = image || site.shareImage || '/images/share-default.png';
const shareImageUrl = absolute(shareImage, Astro.site);
const favicon = site.favicon ? url(site.favicon) : url('/favicon.svg');
const font = fonts();

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: orgFullName,
  alternateName: [orgName, orgTitle, `${orgFullName}: ${site.tagline}`],
  slogan: site.tagline,
  url: new URL(url('/'), Astro.site).toString(),
  logo: site.logo ? absolute(site.logo, Astro.site) : undefined,
  email: site.email,
  telephone: site.phone,
  foundingDate: site.foundedYear,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '25/125, Near Government Secretariat, Pulimoodu',
    addressLocality: 'Thiruvananthapuram',
    addressRegion: 'Keralam',
    postalCode: '695001',
    addressCountry: 'IN',
  },
  sameAs: socialLinks.map((s) => s.href).filter((h) => !/^https:\/\/(www\.)?[a-z]+\.com\/?$/.test(h)),
};
const graphs = [organisation, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
// html:root outranks the defaults in global.css, which load after this tag.
const fontVars = `html:root{--display:${font.display};--text:${font.text};}`;
---

<!doctype html>
<html lang="en-IN" data-fonts={site.fontPairing ?? 'editorial'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a1b2e" />
    <meta name="color-scheme" content="light" />

    <meta property="og:site_name" content={orgTitle} />
    <meta property="og:title" content={isHome ? orgTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="en_IN" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {authors.map((a) => <meta property="article:author" content={a} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={isHome ? orgTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />

    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href={url('/images/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${orgTitle}: publications`} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={font.href} />
    <style is:inline set:html={fontVars}></style>

    {graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}

    {site.analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
        <script is:inline define:vars={{ id: site.analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <Ticker />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
